# react-leaflet@^5 declares a peer dependency on React 19, but this project runs
# React 18. npm treats that as a hard error, so a plain `npm install` — and the
# `npm ci` that CI and Netlify run automatically — both abort before any build
# command gets a chance to run.
#
# The dependency is unused: nothing in src/ imports leaflet, react-leaflet or
# mapbox-gl. Removing those four packages would be the real fix, but that is a
# dependency change rather than a design change, so it stays out of the
# one-pager experiment. Until then this keeps installs working everywhere —
# locally, in CI, and on Netlify.
legacy-peer-deps=true
